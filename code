#IoT Based Gas Leak Detector

#define BLYNK_TEMPLATE_ID "TMPL3rVokbOwx"
#define BLYNK_TEMPLATE_NAME "gas detector"
#define BLYNK_AUTH_TOKEN "cR1-DFXu4dz-sZZ8aT6-CEgA7WyaoZwu"
#include <WiFi.h>
#include <BlynkSimpleEsp32.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
char ssid[] = "Galaxy A21s";
char pass[] = "shubham2005";
#define MQ2_PIN 34
#define BUZZER 25
#define RED_LED 26
#define GREEN_LED 27
LiquidCrystal_I2C lcd(0x27, 16, 2);
BlynkTimer timer;
bool alertSent = false;
void sendSensor()
{
int gasValue = analogRead(MQ2_PIN);
Serial.print("Gas Value: ");
Serial.println(gasValue);
Blynk.virtualWrite(V0, gasValue);
lcd.setCursor(0, 0);
lcd.print("Gas:");
lcd.print(gasValue);
lcd.print(" ");
if (gasValue >= 700)
{
digitalWrite(BUZZER, HIGH);
digitalWrite(RED_LED, HIGH);
digitalWrite(GREEN_LED, LOW);
lcd.setCursor(0, 1);
lcd.print("GAS LEAKAGE! ");
Blynk.virtualWrite(V1, "GAS LEAKAGE");
Blynk.virtualWrite(V2, 1);
if (!alertSent)
{
Blynk.logEvent("gas_alert", "Warning! Gas Leakage Detected.");
alertSent = true;
}
}
else
{
digitalWrite(BUZZER, LOW);
digitalWrite(RED_LED, LOW);
digitalWrite(GREEN_LED, HIGH);
lcd.setCursor(0, 1);
lcd.print("SAFE ");
Blynk.virtualWrite(V1, "SAFE");
Blynk.virtualWrite(V2, 0);
alertSent = false;
}
}
void setup()
{
Serial.begin(115200);
pinMode(BUZZER, OUTPUT);
pinMode(RED_LED, OUTPUT);
pinMode(GREEN_LED, OUTPUT);
digitalWrite(BUZZER, LOW);
digitalWrite(RED_LED, LOW);
digitalWrite(GREEN_LED, HIGH);
lcd.init();
lcd.backlight();
lcd.setCursor(0, 0);
lcd.print("Gas Detector");
lcd.setCursor(0, 1);
lcd.print("Connecting...");
Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);
lcd.clear();
lcd.setCursor(0, 0);
lcd.print("Blynk Connected");
delay(2000);
lcd.clear();
timer.setInterval(1000L, sendSensor);
}
void loop()
{
Blynk.run();
timer.run();
}
